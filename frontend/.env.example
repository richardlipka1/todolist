# Environment Configuration

# Backend API URL for development
# Change this based on your setup:
# - Docker: http://localhost:8080/api.php (default)
# - Apache/Nginx with 'todolist' folder: http://localhost/todolist/backend/api.php
# - PHP built-in server: http://localhost:8080/api.php

REACT_APP_API_URL=http://localhost:8080/api.php
